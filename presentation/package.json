{
  "name": "@traigent/first-run-scenario-presentation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "validate": "tsx scripts/validate-content.ts",
    "build:web": "vite build",
    "build:pptx": "tsx scripts/build-pptx.ts",
    "build:bundle": "tsx scripts/build-bundle.ts",
    "fit:browser": "tsx scripts/check-browser-fit.ts",
    "build": "npm run validate && npm run build:web && npm run build:pptx && npm run build:bundle",
    "format:check": "prettier --check --ignore-path ../.gitignore \"**/*.{ts,tsx,css,json,html,md}\"",
    "check": "npm run typecheck && npm run format:check && npm run test && npm run build && npm run fit:browser"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "jszip": "3.10.1",
    "image-size": "file:vendor/image-size-disabled",
    "pptxgenjs": "4.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "image-size": "$image-size"
  }
}
