{"input": "A sequence of one or more words separated by single spaces.", "output": "\\w+(?: \\w+)*", "metadata": {"difficulty": "hard", "split": "holdout", "provenance": "real", "must_match": ["one two"], "must_reject": [""]}}
{"input": "The word password in any mix of upper and lower case.", "output": "password", "metadata": {"difficulty": "hard", "split": "holdout", "provenance": "real", "must_match": ["password"], "must_reject": ["PASSWORD"]}}
